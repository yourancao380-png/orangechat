+
+private fun Modifier.catBubbleDecoration(
+    enabled: Boolean,
+    color: Color,
+    alpha: Float,
+    tailOnRight: Boolean,
+): Modifier = if (!enabled) this else drawWithContent {
+    drawContent()
+    val earHeight = 10.dp.toPx().coerceAtMost(size.height * 0.25f)
+    val earWidth = 14.dp.toPx().coerceAtMost(size.width * 0.18f)
+    val fill = color.copy(alpha = alpha)
+
+    fun drawEar(centerX: Float) {
+        val path = Path().apply {
+            moveTo(centerX - earWidth / 2f, earHeight)
+            lineTo(centerX, 0f)
+            lineTo(centerX + earWidth / 2f, earHeight)
+            close()
+        }
+        drawPath(path = path, color = fill)
+    }
+
+    drawEar(size.width * 0.34f)
+    drawEar(size.width * 0.66f)
+
+    val edgeX = if (tailOnRight) size.width - 2.dp.toPx() else 2.dp.toPx()
+    val direction = if (tailOnRight) -1f else 1f
+    val tail = Path().apply {
+        moveTo(edgeX, size.height * 0.72f)
+        cubicTo(
+            edgeX + direction * 4.dp.toPx(), size.height * 0.88f,
+            edgeX + direction * 10.dp.toPx(), size.height * 0.96f,
+            edgeX + direction * 2.dp.toPx(), size.height - 3.dp.toPx(),
+        )
+    }
+    drawPath(
+        path = tail,
+        color = fill,
+        style = Stroke(width = 2.4.dp.toPx(), cap = StrokeCap.Round),
+    )
+}
  
